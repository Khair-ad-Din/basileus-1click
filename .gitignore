# Ajustes y estado LOCALES de la maquina (no se comparten)
.claude/settings.local.json
.claude/.state/

# Arneses de verificacion temporales: se generan, se usan y se borran.
# Nunca deben llegar al repo (ni a GitHub Pages). Ver basileus-dev-workflow.
call-of-war/_test_*
call-of-war/_preview*

# Logs economicos de partida: son DATOS de una partida concreta, no codigo.
# Los genera tools/econlog-server.mjs (ese si se versiona). El .N son partidas
# anteriores que el recolector archiva solo al detectar una partida nueva.
tools/*.jsonl
tools/*.jsonl.*
